<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
      body {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        font-family: "Montserrat", sans-serif;
        min-height: 100vh;
      }
      .dashboard-container {
        max-width: 1100px;
        margin: 40px auto;
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 8px 32px rgba(30, 60, 114, 0.15);
        padding: 40px 32px 32px 32px;
      }
      .dashboard-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 32px;
      }
      .dashboard-header h1 {
        font-size: 2.5rem;
        color: #1e3c72;
        margin: 0;
      }
      .dashboard-nav a {
        margin-left: 18px;
        font-weight: 600;
        color: #2a5298;
        text-decoration: none;
        transition: color 0.2s;
      }
      .dashboard-nav a:hover {
        color: #1e3c72;
        text-decoration: underline;
      }
      .dashboard-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 28px;
      }
      .card {
        border: none;
        border-radius: 18px;
        box-shadow: 0 4px 16px rgba(30, 60, 114, 0.08);
        transition: transform 0.15s;
      }
      .card:hover {
        transform: translateY(-6px) scale(1.03);
        box-shadow: 0 8px 32px rgba(30, 60, 114, 0.15);
      }
      .card-title {
        color: #1e3c72;
        font-size: 1.3rem;
        font-weight: 700;
      }
      .card-text {
        color: #444;
      }
      .btn-primary {
        background: linear-gradient(90deg, #1e3c72 0%, #2a5298 100%);
        border: none;
        font-weight: 600;
        border-radius: 8px;
        transition: background 0.2s;
      }
      .btn-primary:hover {
        background: linear-gradient(90deg, #2a5298 0%, #1e3c72 100%);
      }
    </style>
  </head>
  <body>
    <div class="dashboard-container">
      <div class="dashboard-header">
        <h1>Dashboard</h1>
        <nav class="dashboard-nav">
          <a href="/">Accueil</a>
          <a href="/users">Utilisateurs</a>
          <a href="/add-user">Ajouter</a>
          <a href="/random">Superhéros</a>
        </nav>
      </div>
      <div
        class="dashboard-container"
        style="
          max-width: 1100px;
          margin: 40px auto;
          background: #fff;
          border-radius: 24px;
          box-shadow: 0 8px 32px rgba(30, 60, 114, 0.15);
          padding: 40px 32px 32px 32px;
        "
      >
        <div
          class="dashboard-header d-flex align-items-center justify-content-between mb-4"
        >
          <h1 style="font-size: 2.5rem; color: #1e3c72; margin: 0">
            Dashboard
          </h1>
        </div>
        <div
          class="dashboard-cards"
          style="
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 28px;
          "
        >
          <div class="card p-4">
            <h2 class="card-title">👥 Utilisateurs</h2>
            <p class="card-text">
              Voir la liste complète des utilisateurs enregistrés.
            </p>
            <a href="/users" class="btn btn-primary mt-2"
              >Voir les utilisateurs</a
            >
          </div>
          <div class="card p-4">
            <h2 class="card-title">➕ Ajouter un utilisateur</h2>
            <p class="card-text">
              Ajoutez un nouvel utilisateur avec son profil GitHub et QR code.
            </p>
            <a href="/add-user" class="btn btn-primary mt-2">Ajouter</a>
          </div>
          <div class="card p-4">
            <h2 class="card-title">🔍 Recherche</h2>
            <p class="card-text">Recherchez un utilisateur par son nom.</p>
            <form action="/users/search" method="get" class="d-flex">
              <input
                type="text"
                name="q"
                class="form-control me-2"
                placeholder="Nom de l'utilisateur"
              />
              <button type="submit" class="btn btn-primary">Rechercher</button>
            </form>
          </div>
          <div class="card p-4">
            <h2 class="card-title">🦸‍♂️ Superhéros aléatoire</h2>
            <p class="card-text">Générez un nom de superhéros amusant !</p>
            <a href="/random" class="btn btn-primary mt-2">Générer</a>
          </div>
        </div>
      </div>
      <h2 class="card-title">🦸‍♂️ Superhéros aléatoire</h2>
    </div>
  </body>
</html>
