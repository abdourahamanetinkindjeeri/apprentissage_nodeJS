<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= typeof title !== 'undefined' ? title : 'Mini-Site' %></title>
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/main.css" />
  </head>
  <body>
    <div style="display: flex; min-height: 100vh">
      <nav class="sidebar" style="width: 240px; min-height: 100vh">
        <h2
          style="font-weight: bold; margin-bottom: 1.5rem; letter-spacing: 2px"
        >
          MINI-SITE
        </h2>
        <a href="/" class="nav-link">Accueil</a>
        <a href="/dashboard" class="nav-link">Dashboard</a>
        <a href="/users" class="nav-link">Utilisateurs</a>
        <a href="/add-user" class="nav-link">Ajouter Utilisateur</a>
        <a href="/random" class="nav-link">Superhéros</a>
        <a href="/users/search" class="nav-link">Recherche</a>
        <div style="margin-top: auto; font-size: small; color: #888">
          &copy; <%= new Date().getFullYear() %> Mini-Site
        </div>
      </nav>
      <main
        style="flex-grow: 1; padding: 2rem"
        style="
          background: linear-gradient(135deg, #f4f7fa 0%, #e9eefa 100%);
          min-height: 100vh;
        "
      >
        <%- body %>
      </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.js"></script>
  </body>
</html>
