<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Accueil</title>
    <style>
      body {
        background: #f4f6fa;
        font-family: "Segoe UI", Arial, sans-serif;
        margin: 0;
        padding: 0;
      }
      .main-container {
        max-width: 480px;
        margin: 60px auto;
        background: #fff;
        border-radius: 18px;
        box-shadow: 0 4px 24px #0001;
        padding: 2.5rem 2rem 2rem 2rem;
        text-align: center;
      }
      h1 {
        font-size: 2.1rem;
        margin-bottom: 1.5rem;
        color: #222;
        letter-spacing: 1px;
      }
      .search-form {
        display: flex;
        gap: 0.5rem;
        margin: 0 auto 1.5rem auto;
        max-width: 340px;
      }
      .search-form input[type="text"] {
        flex: 1;
        padding: 0.6rem 1rem;
        border: 1px solid #ccc;
        border-radius: 8px;
        font-size: 1rem;
        outline: none;
        transition: border 0.2s;
      }
      .search-form input[type="text"]:focus {
        border: 1.5px solid #007bff;
      }
      .search-form button {
        background: #007bff;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 0.6rem 1.2rem;
        font-size: 1rem;
        cursor: pointer;
        transition: background 0.2s;
      }
      .search-form button:hover {
        background: #0056b3;
      }
      .superhero {
        background: #e7f3ff;
        color: #31708f;
        border-radius: 10px;
        padding: 1rem 0.5rem;
        margin-bottom: 1.5rem;
        font-size: 1.1rem;
      }
      .hero-btn {
        display: inline-block;
        background: linear-gradient(90deg, #007bff 60%, #00c6ff 100%);
        color: #fff;
        border: none;
        border-radius: 24px;
        padding: 0.8rem 2.2rem;
        font-size: 1.1rem;
        font-weight: 600;
        margin-top: 1.2rem;
        box-shadow: 0 2px 8px #007bff22;
        cursor: pointer;
        transition: background 0.2s, box-shadow 0.2s;
        text-decoration: none;
      }
      .hero-btn:hover {
        background: linear-gradient(90deg, #0056b3 60%, #00aaff 100%);
        box-shadow: 0 4px 16px #007bff33;
      }
    </style>
  </head>
  <body>
    <div class="main-container">
      <h1>Bienvenue sur le mini-site !</h1>
      <form action="/users/search" method="get" class="search-form">
        <input type="text" name="q" placeholder="Rechercher un utilisateur" />
        <button type="submit">Rechercher</button>
      </form>
      <% if(hero){ %>
      <div class="superhero">🦸‍♂️ Superhéros aléatoire : <b><%= hero %></b></div>
      <% } %>
      <a href="/random" class="hero-btn">Générer un superhéros</a>
    </div>
  </body>
</html>
